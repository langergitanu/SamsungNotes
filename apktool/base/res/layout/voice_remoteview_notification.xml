<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:gravity="center_vertical" android:layout_width="match_parent" android:layout_height="wrap_content"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:orientation="vertical" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentStart="true">
        <ImageView android:id="@id/notification_voice_icon" android:visibility="gone" android:layout_width="0.0dp" android:layout_height="0.0dp" />
        <TextView android:textAppearance="@style/RobotoMediumStyle" android:textSize="@dimen/notification_voice_time_text_size" android:textColor="@color/colorized_notification_first_text_color" android:id="@id/notification_voice_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/voice_default_time" />
        <TextView android:textAppearance="@style/RobotoRegularStyle" android:textSize="@dimen/notification_voice_status_text_size" android:textColor="@color/colorized_notification_second_text_color" android:id="@id/notification_voice_status" android:paddingTop="@dimen/notification_24_voice_status_padding_top" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Recording" />
    </LinearLayout>
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerVertical="true" android:layout_alignParentEnd="true">
        <ImageButton android:id="@id/notification_button_cancel" android:background="@drawable/voice_notification_button_circular_ripple_n" android:layout_width="@dimen/notification_23_voice_cancel_button_size" android:layout_height="@dimen/notification_23_voice_cancel_button_size" android:scaleType="fitXY" android:contentDescription="@string/composer_string_close" android:layout_marginEnd="@dimen/notification_end_margin" />
        <ImageButton android:id="@id/notification_first_button" android:background="@drawable/voice_notification_button_circular_ripple_n" android:layout_width="@dimen/notification_voice_button_size" android:layout_height="@dimen/notification_voice_button_size" android:scaleType="fitXY" android:contentDescription="@string/voice_notification_voice_ass_stop" android:layout_marginEnd="@dimen/notification_end_margin" />
        <ImageButton android:id="@id/notification_second_button" android:background="@drawable/voice_notification_button_circular_ripple_n" android:layout_width="@dimen/notification_voice_button_size" android:layout_height="@dimen/notification_voice_button_size" android:scaleType="fitXY" android:contentDescription="@string/voice_notification_voice_ass_pause" />
    </LinearLayout>
</RelativeLayout>
