<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <LinearLayout android:gravity="center_vertical" android:orientation="horizontal" android:id="@id/notes_custom_appbar" android:layout_width="match_parent" android:layout_height="wrap_content">
        <ImageView android:id="@id/drawer_button" android:background="@drawable/default_ripple_outside_view" android:padding="@dimen/tablet_drawer_default_icon_padding" android:layout_width="@dimen/tablet_drawer_bar_icon_size" android:layout_height="@dimen/tablet_drawer_bar_icon_size" android:src="@drawable/ic_drawer" android:tint="@color/folder_list_item_filter_icon_color" android:contentDescription="@string/drawer_description" />
        <LinearLayout android:orientation="horizontal" android:layout_width="0.0dp" android:layout_height="@dimen/tablet_drawer_bar_icon_size" android:layout_weight="1.0">
            <EditText android:ellipsize="end" android:gravity="center_vertical" android:id="@id/text_input_dialog" android:background="#aaaaaa" android:layout_width="wrap_content" android:layout_height="match_parent" android:minWidth="100.0dp" android:hint="Title" android:singleLine="true" android:paddingStart="3.0dp" android:paddingEnd="3.0dp" />
            <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
