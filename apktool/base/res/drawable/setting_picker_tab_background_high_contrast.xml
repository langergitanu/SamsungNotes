<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/setting_width_item_selected_color" />
            <corners android:radius="@dimen/setting_pen_layout_width_item_radius" />
            <stroke android:width="@dimen/setting_change_style_chip_unselected_outline_size" android:color="@color/setting_high_contrast_select_stroke_color" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="@dimen/setting_pen_layout_width_item_radius" />
        </shape>
    </item>
</selector>
