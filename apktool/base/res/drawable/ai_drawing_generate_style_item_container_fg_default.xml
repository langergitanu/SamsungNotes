<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <inset>
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/ai_drawing_style_list_item_radius" />
                <stroke android:width="2.5dp" android:color="@color/ai_drawing_request_layout_bg_color" />
            </shape>
        </inset>
    </item>
    <item>
        <inset android:inset="3.0dp">
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/ai_drawing_style_list_item_inner_radius" />
                <stroke android:width="1.0dp" android:color="#0d010102" />
            </shape>
        </inset>
    </item>
</layer-list>
