<?xml version="1.0" encoding="utf-8"?>
<layer-list
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@id/layer_bg">
        <selector android:shape="rectangle">
            <item android:state_selected="true">
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/background_color_palette_radius" />
                </shape>
            </item>
            <item>
                <shape android:shape="rectangle" />
            </item>
        </selector>
    </item>
    <item android:id="@id/layer_overlay" android:drawable="@android:color/transparent" />
</layer-list>
