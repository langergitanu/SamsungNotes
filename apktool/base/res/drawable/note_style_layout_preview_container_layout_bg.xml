<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/change_template_selected_thumbnail_bg" />
            <corners android:radius="@dimen/note_style_layout_medium_radius" />
        </shape>
    </item>
    <item android:state_selected="false">
        <shape>
            <solid android:color="@color/change_template_unselected_thumbnail_bg" />
            <corners android:radius="@dimen/note_style_layout_medium_radius" />
        </shape>
    </item>
</selector>
