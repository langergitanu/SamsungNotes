<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppMainThemeNoChunking" parent="@style/AppTheme.NoActionBar">
        <item name="android:windowBackground">@color/noteslist_fragment_bg_color</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="actionModeCloseButtonStyle">@style/ActionModeCloseButton</item>
    </style>
    <style name="AppPreferenceTheme" parent="@style/AppMainTheme">
        <item name="android:listSeparatorTextViewStyle">@style/SettingsListSeparator</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="colorPrimaryDark">@color/notes_primary_color</item>
        <item name="preferenceTheme">@style/PreferenceThemeOverlay</item>
    </style>
    <style name="Base.TextAppearance.AppCompat.Widget.ActionBar.Subtitle" parent="@style/TextAppearance.AppCompat.Subhead">
        <item name="android:textSize">@dimen/sesl_toolbar_subtitle_text_size</item>
        <item name="android:textColor">@color/sesl_action_bar_text_color_subtitle_dark</item>
        <item name="fontFamily">@string/sesl_font_family_regular</item>
        <item name="textAllCaps">false</item>
    </style>
    <style name="Base.TextAppearance.AppCompat.Widget.ActionBar.Title" parent="@style/TextAppearance.AppCompat.Title">
        <item name="android:textSize">@dimen/sesl_toolbar_title_text_size</item>
        <item name="android:textStyle">@string/sesl_text_style_medium</item>
        <item name="android:textColor">@color/sesl_action_bar_text_color_title_dark</item>
        <item name="fontFamily">@string/sesl_font_family_medium</item>
        <item name="textAllCaps">false</item>
    </style>
    <style name="Base.TextAppearance.AppCompat.Widget.Button" parent="@style/TextAppearance.AppCompat.Button">
        <item name="android:textStyle">@string/sesl_text_style_medium</item>
        <item name="android:textColor">@color/sesl_btn_text_color_dark</item>
        <item name="fontFamily">@string/sesl_font_family_medium</item>
    </style>
    <style name="Base.TextAppearance.AppCompat.Widget.Light.Button" parent="@style/TextAppearance.AppCompat.Button">
        <item name="android:textStyle">@string/sesl_text_style_medium</item>
        <item name="android:textColor">@color/sesl_btn_text_color_light</item>
        <item name="fontFamily">@string/sesl_font_family_medium</item>
    </style>
    <style name="CustomAppMainTheme" parent="@style/AppTheme.NoActionBar">
        <item name="android:windowBackground">@color/window_background_color</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/window_background_color</item>
        <item name="android:enforceNavigationBarContrast">false</item>
        <item name="actionModeCloseButtonStyle">@style/ActionModeCloseButton</item>
        <item name="windowActionBar">false</item>
        <item name="windowActionModeOverlay">true</item>
        <item name="windowNoTitle">true</item>
    </style>
    <style name="Glance.AppWidget.Background" parent="@style/Base.Glance.AppWidget.Background">
        <item name="android:padding">16.0dp</item>
        <item name="android:clipToOutline">true</item>
    </style>
