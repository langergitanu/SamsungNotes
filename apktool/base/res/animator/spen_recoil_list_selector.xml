<?xml version="1.0" encoding="utf-8"?>
<selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <set>
            <objectAnimator android:interpolator="@anim/spen_recoil_pressed_scale_interpolator" android:duration="100" android:valueTo="0.98" android:valueType="floatType" android:propertyName="scaleX" />
            <objectAnimator android:interpolator="@anim/spen_recoil_pressed_scale_interpolator" android:duration="100" android:valueTo="0.98" android:valueType="floatType" android:propertyName="scaleY" />
        </set>
    </item>
    <item android:state_pressed="false">
        <set>
            <objectAnimator android:interpolator="@anim/spen_recoil_pressed_scale_interpolator" android:duration="350" android:valueTo="1" android:valueType="floatType" android:propertyName="scaleX" />
            <objectAnimator android:interpolator="@anim/spen_recoil_pressed_scale_interpolator" android:duration="350" android:valueTo="1" android:valueType="floatType" android:propertyName="scaleY" />
        </set>
    </item>
</selector>
